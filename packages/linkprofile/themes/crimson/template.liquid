<!doctype html>
<html lang="en" data-mode="{{ theme.options.mode }}">
<head>
{% include 'linkprofile-meta' %}
</head>
<body style="--accent: {{ theme.options.accent }}">
<main class="cr-stage">
  <header class="cr-hero">
    <div class="cr-identity">
      {%- if profile.avatar_url %}
      <img class="cr-avatar" src="{{ profile.avatar_url }}" alt="" width="80" height="80">
      {%- endif %}
      <div class="cr-identity-text">
        <h1 class="cr-title">{{ profile.name }}</h1>
        {%- if profile.bio %}
        <p class="cr-bio">{{ profile.bio }}</p>
        {%- endif %}
      </div>
    </div>
    {%- if profile.socials.size > 0 %}
    <ul class="cr-socials">
      {%- for s in profile.socials %}
      <li><a class="cr-social-btn" href="{{ s.url }}" aria-label="{{ s.label }}"{% if s.url contains '://' %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ s.svg | raw }}</a></li>
      {%- endfor %}
    </ul>
    {%- endif %}
  </header>
  {%- if profile.links.size > 0 %}
  {%- if profile.links_title %}
  <div class="cr-section-header">
    <h2 class="cr-section-label">{{ profile.links_title }}</h2>
    <div class="cr-section-rule" aria-hidden="true"></div>
  </div>
  {%- endif %}
  <ul class="cr-links">
    {%- for l in profile.links %}
    <li>
      <a class="cr-link-card" href="{{ l.url }}"{% if l.external %} rel="noopener"{% endif %}>
        <span class="cr-icon-tile{% if l.image_url %} is-image{% elsif l.color %} is-colored{% if l.color_is_dark %} ink-light{% endif %}{% endif %}"{% if l.color %} style="--link-color: {{ l.color }}"{% endif %}>
          {%- if l.image_url -%}
          <img src="{{ l.image_url }}" alt="" width="44" height="44">
          {%- elsif l.icon_svg -%}
          {{ l.icon_svg | raw }}
          {%- else -%}
          <span class="cr-initial" aria-hidden="true">{{ l.title | slice: 0 | upcase }}</span>
          {%- endif -%}
        </span>
        <span class="cr-link-text">
          <span class="cr-link-title">{{ l.title }}</span>
          {%- if l.external %}
          {%- assign parts = l.url | split: "/" %}
          <span class="cr-link-url">{{ parts[2] | split: "?" | first | split: "#" | first | split: "@" | last }}</span>
          {%- else %}
          {%- assign scheme = l.url | split: ":" | first | downcase %}
          {%- if scheme == 'mailto' or scheme == 'tel' %}
          {%- assign start = scheme.size | plus: 1 %}
          <span class="cr-link-url">{{ l.url | slice: start, 2000 | split: "?" | first }}</span>
          {%- endif %}
          {%- endif %}
        </span>
        <svg class="cr-arrow" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </li>
    {%- endfor %}
  </ul>
  {%- endif %}
</main>
</body>
</html>
